# Dashboard configuration. Copy to .env (mode 600) and fill in. Never commit .env.
CORAL_DATA_DIR=./data
# At least 32 random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
CORAL_SECRET_KEY=
# Generate with: signagectl admin hash-password
CORAL_ADMIN_PASSWORD_HASH=
# Set to false only for local development over plain http.
CORAL_COOKIE_SECURE=true
CORAL_TIMEZONE=Europe/Lisbon
CORAL_DEFAULT_IMAGE_DURATION_S=10
CORAL_MIN_FREE_MB=2048
CORAL_MAX_UPLOAD_MB=2048
CORAL_MEDIA_GRACE_DAYS=7
CORAL_FFPROBE=ffprobe
# Accepted media profile (spec 4.5); tune after tests on the real screen.
CORAL_IMAGE_MAX_PX=4096
CORAL_VIDEO_MAX_WIDTH=1920
CORAL_VIDEO_MAX_HEIGHT=1080
CORAL_VIDEO_MAX_FPS=30
CORAL_VIDEO_MAX_BITRATE_KBPS=20000
# Heartbeat interval sent to players (30-60 s); offline after 3 missed heartbeats.
CORAL_HEARTBEAT_INTERVAL_S=60
