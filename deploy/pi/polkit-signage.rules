// /etc/polkit-1/rules.d/50-signage.rules
// Lets the signage-agent user (no root, NoNewPrivileges) run exactly the two
// privileged remote commands of spec 5.2, and nothing else:
//   restart-player -> systemctl restart mpv.service
//   reboot         -> systemctl reboot
// Requires polkit >= 0.106 (JavaScript rules); check with `pkaction --version`.
polkit.addRule(function (action, subject) {
    if (subject.user !== "signage") {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
            action.lookup("unit") === "mpv.service" &&
            action.lookup("verb") === "restart") {
        return polkit.Result.YES;
    }
    if (action.id === "org.freedesktop.login1.reboot" ||
            action.id === "org.freedesktop.login1.reboot-multiple-sessions") {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
